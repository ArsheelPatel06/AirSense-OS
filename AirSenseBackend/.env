# AirSense Backend Configuration Example

# Application
ENVIRONMENT=development
PROJECT_NAME="AirSense Intelligence Platform"
API_V1_STR="/api/v1"

# Security
# Generate securely via: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://airsense:airsense_pass@localhost:5432/airsense_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
